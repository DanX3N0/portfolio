---
const categories = [
	{
		titleKey: "skills.lang",
		skills: ["TypeScript", "JavaScript", "Odin", "C++", "Python", "SQL"],
	},
	{
		titleKey: "skills.frontend",
		skills: ["React", "Next.js", "Astro", "Tailwind CSS", "HTML5 / CSS3"],
	},
	{
		titleKey: "skills.backend",
		skills: [
			"Node.js / Bun",
			"PostgreSQL / MongoDB",
			"Docker",
			"Linux(Bash/Shell)",
		],
	},
	{
		titleKey: "skills.tools",
		skills: [
			"Git & Github",
			"Postman",
			"Figma",
			"Jupyter Notebooks",
			"Tableau / Power BI",
		],
	},
];
---

<section id="skills" class="relative py-24 px-6 bg-stone-950/40">
	<div class="max-w-6xl mx-auto">
		<div class="reveal">
			<p data-i18n="skills.label" class="text-stone-400 text-sm font-medium tracking-widest uppercase mb-2">
				Skills
			</p>
			<h2 data-i18n="skills.title" class="text-3xl md:text-4xl font-bold text-white mb-12">
				Tech Stack
			</h2>
		</div>

		<div class="grid grid-cols-2 md:grid-cols-4 gap-6">
			{categories.map((cat) => (
				<div class="reveal bg-stone-900/50 border border-stone-800 rounded-xl p-6 hover:border-stone-500/30 transition-all duration-300">
					<h3 data-i18n={cat.titleKey} class="text-white font-semibold mb-4 text-sm uppercase tracking-wider">
						{cat.titleKey}
					</h3>
					<ul class="space-y-2">
						{cat.skills.map((skill) => (
							<li class="text-stone-400 text-sm flex items-center gap-2">
								<span class="w-1.5 h-1.5 bg-stone-500 rounded-full" />
								{skill}
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</div>
</section>
