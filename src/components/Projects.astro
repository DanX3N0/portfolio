---
const projects = [
{
		titleKey: "projects.0.title",
		descKey: "projects.0.desc",
    tags: [ "For Fun", "TypeScript", "PixiJS", "React", "Algorithms"],
		link: "#",
	},
	{
		titleKey: "projects.1.title",
		descKey: "projects.1.desc",
    tags: ["For Fun", "Astro", "React", "Tailwind CSS", "SEO"],
		link: "#",
  },
  {
    titleKey: "projects.2.title",
    descKey: "projects.2.desc",
    tags: ["JavaScript", "React", "React Native", "MongoDB", "ReactAdmin", "Express", "Context API", "NestJs", "Microservices", "Docker", "3rd party APIs", "Gemini API", "Redux"],
    link: "#",
  },
  {
    titleKey: "projects.3.title",
    descKey: "projects.3.desc",
    tags: ["Astro", "React", "MongoDB", "TailwindCSS", "Express", "TanStack", "Node", "TypeScript"],
    link: "#",
  }
];
---

<section id="projects" class="relative py-24 px-6">
	<div class="max-w-6xl mx-auto">
		<div class="reveal">
			<h2 data-i18n="projects.title" class="text-3xl md:text-4xl font-bold text-white mb-12">
				Projects
			</h2>
		</div>

		<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
			{projects.map((project) => (
				<article class="reveal group bg-stone-900/50 border border-stone-800 rounded-xl p-6 hover:border-stone-500/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-stone-500/5">
					<div class="flex items-start justify-between mb-4">
						<h3 data-i18n={project.titleKey} class="text-lg font-semibold text-white group-hover:text-stone-300 transition-colors">
							{project.titleKey}
						</h3>
						<a
							href={project.link}
							class="text-stone-600 hover:text-stone-300 transition-colors"
							aria-label="View project"
						>
							<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
							</svg>
						</a>
					</div>
					<p data-i18n={project.descKey} class="text-stone-400 text-sm leading-relaxed mb-4">
						{project.descKey}
					</p>
					<div class="flex flex-wrap gap-2">
						{project.tags.map((tag) => (
							<span class="text-xs px-2.5 py-1 bg-stone-800/60 text-stone-400 rounded-full border border-stone-700/50">
								{tag}
							</span>
						))}
					</div>
				</article>
			))}
		</div>
	</div>
</section>
